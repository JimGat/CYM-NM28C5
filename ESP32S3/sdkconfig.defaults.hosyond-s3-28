# Hosyond ESP32-S3 2.8" board-specific sdkconfig overrides
# Layered on top of sdkconfig.defaults (shared ESP32-S3 base).
#
# Board: Hosyond ESP32-S3 Touchscreen Module 2.8" 240x320 (ASIN B0FKG7WRWV)
# SoC:   ESP32-S3R8, dual-core Xtensa LX7 240 MHz
# Flash: 16 MB (Quad SPI)
# PSRAM: 8 MB (OPI, internal stacked)
# LCD:   ILI9341V SPI, 240x320
#   CS:    GPIO10,  DC: GPIO46,  SCK: GPIO12,  MOSI: GPIO11,  MISO: GPIO13
#   BL:    GPIO45 (PWM capable)
#   RST:   shared with ESP32-S3 RST line
# Touch: FT6336G capacitive I2C
#   SDA:   GPIO16,  SCL: GPIO15,  RST: GPIO18,  INT: GPIO17
# Audio: Built-in mic + speaker support (future)
# USB:   Type-C
#
# Dual-core advantage: jammer task pins to Core 1 via xTaskCreatePinnedToCore.
#
# Phase 4 — fill in when porting begins.

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# CONFIG_BOARD_HOSYOND_S3_28=y  (future Kconfig flag)
